{
  "name": "Ampolin AI Agent - Groq + Gemini + Ollama Hybrid",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ampolin-agent",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Ampolin Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "ampolin-agent"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message || $json.body.prompt }}",
        "options": {
          "systemMessage": "You are Ampolin AI, an elite autonomous coding agent with computer control and deep reasoning capabilities. You provide clear, concise, type-safe code, step-by-step reasoning, and tool suggestions."
        }
      },
      "id": "ai-agent-core",
      "name": "Ampolin Autonomous Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [520, 300]
    },
    {
      "parameters": {
        "modelName": "llama-3.3-70b-versatile",
        "options": {
          "temperature": 0.3
        }
      },
      "id": "groq-chat-model",
      "name": "Groq Llama 3.3 70B",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [420, 520],
      "credentials": {
        "groqApi": {
          "id": "groq-cred",
          "name": "Groq API account"
        }
      }
    },
    {
      "parameters": {
        "modelName": "gemini-2.0-flash",
        "options": {
          "temperature": 0.4
        }
      },
      "id": "gemini-chat-model",
      "name": "Google Gemini 2.0 Flash",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [620, 520],
      "credentials": {
        "googlePalmApi": {
          "id": "gemini-cred",
          "name": "Google Gemini account"
        }
      }
    },
    {
      "parameters": {
        "model": "qwen2.5-coder:1.5b",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "ollama-chat-model",
      "name": "Ollama Offline Fallback",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [820, 520],
      "credentials": {
        "ollamaApi": {
          "id": "ollama-cred",
          "name": "Ollama Local account"
        }
      }
    },
    {
      "parameters": {
        "contextWindowLength": 10
      },
      "id": "window-memory",
      "name": "Chat Memory Window",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [520, 120]
    }
  ],
  "connections": {
    "Ampolin Webhook Trigger": {
      "main": [
        [
          {
            "node": "Ampolin Autonomous Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Groq Llama 3.3 70B": {
      "ai_languageModel": [
        [
          {
            "node": "Ampolin Autonomous Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Chat Memory Window": {
      "ai_memory": [
        [
          {
            "node": "Ampolin Autonomous Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
