{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "deploy/**",
      "*.bat",
      "server.js",
      "package*.json",
      "README.md",
      "render.yaml"
    ],
    "rewrites": [
      {
        "source": "/mobile",
        "destination": "/mobile.html"
      },
      {
        "source": "/",
        "destination": "/index.html"
      }
    ]
  }
}
